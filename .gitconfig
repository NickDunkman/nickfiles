[alias]
	b = branch
	co = checkout
	commit-tree = commit-tree -S
[core]
	pager = less -F -X
	excludesfile = ~/.gitignore_global
[mailmap]
	file = ~/.mailmap
[user]
	name = Nick Dunkman
	email = nickdunkman@gmail.com
	# public half of the SSH key in 1Password, which signs commits
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMHLVGwIjbD7pmMbVYGCzJR5Pb04T8m80DdH8IZwl4go
[pull]
	ff = only
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	# lets `git log --show-signature` verify my commits locally
	allowedSignersFile = ~/.config/git/allowed_signers
