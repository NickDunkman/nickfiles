#!/bin/sh
# nickfiles: one command for my dotfiles. Runs recipes from ~/.config/nickfiles/justfile:
#
#   nickfiles upstall        install & update everything
#   nickfiles git <args>     git against the bare repo in ~/.nickfiles.git, with $HOME as the work tree
#   nickfiles                list the recipes and show `git status`

NICKFILES_DIR="${NICKFILES_DIR:-$HOME/.config/nickfiles}"
export NICKFILES_DIR

nickfiles_just() {
  just --justfile "$NICKFILES_DIR/justfile" --working-directory "$HOME" "$@"
}

if [ $# -eq 0 ]; then
  nickfiles_just --list
  echo
  nickfiles_just git status --short --branch
  exit
fi

nickfiles_just "$@"
