# Recipes for `nickfiles <recipe>`.

set shell := ["bash", "-euo", "pipefail", "-c"]

# pass recipe arguments through as "$@", so quoting survives (e.g. `nickfiles git commit -m "two words"`)
set positional-arguments

nickfiles := env_var("HOME") / ".local/bin/nickfiles"

# Install & update everything. Safe to re-run any time.
[group('installs & updates')]
upstall: _sudo-keepalive _pull upstall-brew upstall-secrets upstall-zsh-plugins upstall-iterm-settings upstall-macos-settings upstall-vscode-extensions upstall-python upstall-node upstall-rust upstall-claude upstall-docker
    #!/usr/bin/env bash
    echo
    echo "✅ nickfiles upstall complete"
    # iTerm2 only reads its prefs at launch
    if [ "${TERM_PROGRAM:-}" = "Apple_Terminal" ]; then
      echo "🚨 Quit Terminal and open iTerm2"
    else
      echo "🚨 Restart iTerm2 (⌘Q, then reopen it) to pick up any iTerm2 & zsh changes"
    fi

# Run git against the nickfiles repo, e.g. `nickfiles git add .some/.file`
[no-exit-message]
[group('nickfiles version control')]
git *args:
    #!/usr/bin/env bash
    # the work tree is $HOME, so `git clean` could delete everything in it
    if [ "${1:-}" = clean ]; then
      echo "nickfiles: refusing to run 'git clean' against \$HOME" >&2
      exit 1
    fi
    exec git --git-dir="$HOME/.nickfiles.git" --work-tree="$HOME" "$@"

# Install/update homebrew & everything in ~/.Brewfile
[group('installs & updates')]
upstall-brew:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "==> Homebrew"
    brew update
    # keep going if some entries fail (e.g. App Store apps before signing in to the App Store)
    if ! brew bundle --global; then
      echo "⚠️ some Brewfile entries failed to install (see above)" >&2
    fi
    brew upgrade --yes
    outdated_apps=$(mas outdated 2>/dev/null || true)
    if [ -n "$outdated_apps" ]; then
      echo "there are app store apps to upgrade! requires password ..."
      mas upgrade || echo "⚠️ couldn't upgrade App Store apps" >&2
    fi

# Write the files in the `nickfiles` 1Password vault into ~
# (each document is titled with its path inside ~, e.g. `.mailmap`)
[group('installs & updates')]
upstall-secrets:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Secrets from 1Password"
    # `op account list` lists the app's accounts only when the CLI integration is on. (Most other
    # `op` commands ask to set up an account by hand when it's off, instead of failing.)
    accounts=$(op account list --format json 2>/dev/null | jq 'length' 2>/dev/null || echo 0)
    agent_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    if [ "${accounts:-0}" -eq 0 ] || [ ! -S "$agent_socket" ]; then
      cat >&2 <<'EOF'
    ⚠️  1Password isn't set up yet, so secrets were skipped.
         1. System Settings → Privacy & Security → Full Disk Access → turn on iTerm2,
            then quit iTerm2 (⌘Q) & reopen it. Otherwise macOS blocks `op` from reaching the 1Password app.
         2. In the 1Password app, sign in
         3. 1Password → Settings → Developer → turn on "Integrate with 1Password CLI"
         4. 1Password → Settings → Developer → "Set up the SSH Agent" (choose "Use key names")
       Then run `nickfiles upstall` again.
    EOF
      exit 0
    fi
    if ! op vault get nickfiles &>/dev/null; then
      echo "⚠️  there's no \`nickfiles\` vault in 1Password, so secrets were skipped" >&2
      exit 0
    fi
    op document list --vault nickfiles --format json | jq -r '.[].title' | while IFS= read -r path; do
      # titles are paths inside ~, so refuse anything that could write outside it
      if [[ $path == /* || $path == *..* ]]; then
        echo "⚠️  skipping 1Password document \"$path\": its title must be a path inside ~" >&2
        continue
      fi
      target="$HOME/$path"
      mkdir -p "$(dirname "$target")"
      new=$(mktemp "$target.XXXXXX")
      op document get "$path" --vault nickfiles --out-file "$new" --force >/dev/null
      chmod 600 "$new"
      if [ -f "$target" ] && cmp -s "$new" "$target"; then
        rm "$new"
      else
        mv "$new" "$target"
        echo "updated ~/$path"
      fi
    done

# Install/update zsh plugins
[group('installs & updates')]
upstall-zsh-plugins:
    @echo "==> zsh plugins"
    SHELL_SESSIONS_DISABLE=1 zsh -i -c true

# Point iTerm2 at my preferences in ~/.config/iterm2
[group('installs & updates')]
upstall-iterm-settings:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> iTerm2"
    folder="$HOME/.config/iterm2"
    current_folder=$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null || true)
    loading=$(defaults read com.googlecode.iterm2 LoadPrefsFromCustomFolder 2>/dev/null || echo 0)
    if [ "$current_folder" = "$folder" ] && [ "$loading" = 1 ]; then
      echo "already loading prefs from $folder"
      exit 0
    fi
    defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$folder"
    defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
    echo "iTerm2 will now load prefs from $folder"

# Apply my macOS settings (Dock, Finder, keyboard)
[group('installs & updates')]
upstall-macos-settings:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> macOS settings"

    # Appearance: always dark mode (fully takes effect at the next login)
    defaults write NSGlobalDomain AppleInterfaceStyle -string Dark
    defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false

    # Clock: always 24-hour time, with seconds
    defaults write NSGlobalDomain AppleICUForce24HourTime -bool true
    defaults write com.apple.menuextra.clock ShowAMPM -bool false
    defaults write com.apple.menuextra.clock ShowSeconds -bool true
    defaults write com.apple.menuextra.clock FlashDateSeparators -bool false

    # Menu bar
    defaults -currentHost write com.apple.controlcenter BatteryShowPercentage -bool true
    defaults -currentHost write com.apple.controlcenter Bluetooth -int 2
    defaults -currentHost write com.apple.controlcenter Sound -int 18
    defaults -currentHost write com.apple.controlcenter AirDrop -int 8
    defaults -currentHost write com.apple.controlcenter Display -int 8
    defaults -currentHost write com.apple.controlcenter Weather -int 8
    defaults write com.apple.Siri StatusMenuVisible -bool false
    defaults write com.apple.TextInputMenu visible -bool false

    # Default browser: Firefox Developer Edition (macOS asks to confirm the first time)
    defaultbrowser firefoxdeveloperedition || echo "⚠️  couldn't set the default browser" >&2

    # Dock
    defaults write com.apple.dock autohide -bool true
    defaults write com.apple.dock tilesize -int 128
    defaults write com.apple.dock show-recents -bool false

    # Finder
    defaults write NSGlobalDomain AppleShowAllExtensions -bool true
    defaults write com.apple.finder AppleShowAllFiles -bool true
    defaults write com.apple.finder FXPreferredViewStyle -string clmv
    defaults write com.apple.finder _FXSortFoldersFirst -bool false
    defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

    # holding a key in VS Code repeats it instead of showing the accent picker
    defaults delete -g ApplePressAndHoldEnabled 2>/dev/null || true
    defaults write com.microsoft.VSCode ApplePressAndHoldEnabled -bool false

    # Sourcetree: use Homebrew's git instead of its bundled one (needed for SSH commit signing).
    # Takes effect the next time Sourcetree opens.
    defaults write com.torusknot.SourceTreeNotMAS gitWhichOne -int 1
    defaults write com.torusknot.SourceTreeNotMAS gitCustomPath -string /opt/homebrew/bin/git

    # Restart the Dock, Finder & menu bar so they pick up the new settings
    killall Dock Finder ControlCenter 2>/dev/null || true

# Install/update the VS Code extensions in ~/.config/vscode/extensions.txt
[group('installs & updates')]
upstall-vscode-extensions:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> VS Code extensions"
    # extension IDs are case-insensitive, and `code --list-extensions` prints them lowercased
    wanted=$(grep -v '^#' "$HOME/.config/vscode/extensions.txt" | tr '[:upper:]' '[:lower:]' | sort -u)
    installed=$(code --list-extensions | tr '[:upper:]' '[:lower:]' | sort -u)
    for extension in $(comm -23 <(echo "$wanted") <(echo "$installed")); do
      code --install-extension "$extension"
    done
    code --update-extensions

# Install/update python & related tooling
[group('installs & updates')]
upstall-python:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Python"
    # `python` & `python3` in ~/.local/bin run this version; projects pin their own (.python-version)
    version=3.14
    uv python install "$version" --default --preview-features python-install-default
    uv python upgrade "$version"
    uv tool upgrade --all

# Install/update node & related tooling
[group('installs & updates')]
upstall-node:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Node"
    eval "$(fnm env --shell bash)"
    lts=$(fnm list-remote --lts --latest | awk '{print $1}')
    if ! fnm list | grep -q "$lts"; then
      fnm install "$lts"
      fnm default "$lts"
    fi
    fnm use "$(fnm default)"
    # to add more global installs, tack them onto this line
    npm install --global corepack
    npm update --global

# Install/update rust
[group('installs & updates')]
upstall-rust:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Rust"
    if command -v rustup &>/dev/null; then
      rustup update
    else
      # ~/.cargo/bin is already on PATH (see ~/.config/zsh/path.zsh)
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
    fi

# Claude Code CLI
[group('installs & updates')]
upstall-claude:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Claude Code"
    if command -v claude &>/dev/null; then
      claude update
    else
      curl -fsSL https://claude.ai/install.sh | bash
    fi

# Install/update docker-related things, like docker-shell
[group('installs & updates')]
upstall-docker: upstall-python
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> docker-shell"
    if ! command -v docker-shell &>/dev/null; then
      uv tool install https://github.com/ewdicus/docker-shell/releases/download/v0.1.0/docker_shell-0.1.0-py3-none-any.whl
    fi

# some installers (e.g. .pkg casks) need sudo: ask once, then keep it alive until `just` exits
[private]
_sudo-keepalive:
    #!/usr/bin/env bash
    sudo -v
    while true; do sudo -n true; sleep 50; kill -0 "$PPID" || exit; done 2>/dev/null &

# pulls down changes to nickfiles from github
[private]
_pull:
    #!/usr/bin/env bash
    echo "==> Pulling the latest nickfiles"
    if ! "{{nickfiles}}" git pull --ff-only; then
      echo "⚠️  couldn't fast-forward nickfiles; continuing with what's checked out" >&2
    fi
